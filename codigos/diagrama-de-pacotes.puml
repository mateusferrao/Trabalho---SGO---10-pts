@startuml diagrama-de-pacotes

skinparam packageStyle rectangle
skinparam package {
  BackgroundColor AliceBlue
  BorderColor Navy
}

package "sgo-frontend\n<<React / TypeScript / Vite>>" as Frontend {
  package "pages" as FrontPages {
    [CompeticoesPage]
    [AtletasPage]
    [ResultadosPage]
    [RelatoriosPage]
  }
  package "components" as FrontComponents {
    [CompetitionCard]
    [AthleteForm]
    [MedalTable]
    [ResultForm]
  }
  package "services" as FrontServices {
    [ApiService]
    [CompetitionService]
    [AthleteService]
    [ReportService]
  }
}

package "sgo-backend\n<<Node.js / TypeScript / Express>>" as Backend {
  package "controllers" as Controllers {
    [CompetitionController]
    [AthleteController]
    [LocalController]
    [RegistrationController]
    [ResultController]
    [ReportController]
  }
  package "use-cases" as UseCases {
    [CadastrarCompeticao]
    [InscreverAtleta]
    [AlocarLocal]
    [RegistrarResultado]
    [GerarRelatorio]
  }
  package "domain" as Domain {
    package "entities" as Entities {
      [Competicao]
      [Atleta]
      [Local]
      [Resultado]
      [Pais]
      [Inscricao]
      [Modalidade]
    }
    package "repositories\n(interfaces fornecidas ao domínio)" as RepositoryPorts {
      [ICompetitionRepo]
      [IAthleteRepo]
      [ILocalRepo]
      [IRegistrationRepo]
      [IResultRepo]
      [IReportRepo]
    }
    package "domain-services" as DomainServices {
      [AlocacaoService]
      [InscricaoService]
      [MedalhaService]
    }
  }
  package "infrastructure" as Infrastructure {
    package "repositories\n(implementam interfaces)" as RepositoryAdapters {
      [CompetitionRepoImpl]
      [AthleteRepoImpl]
      [LocalRepoImpl]
      [RegistrationRepoImpl]
      [ResultRepoImpl]
      [ReportRepoImpl]
    }
    package "database" as DatabaseConfig {
      [TypeORMConfig]
      [Migrations]
    }
  }
}

package "sgo-database\n<<PostgreSQL 15>>" as Database {
  [competicoes]
  [atletas]
  [locais]
  [inscricoes]
  [resultados]
  [paises]
}

Frontend ..> Backend : HTTP REST / JSON
Backend ..> Database : SQL via TypeORM
FrontPages ..> FrontComponents : renderiza
FrontPages ..> FrontServices : consome
Controllers ..> UseCases : invoca
UseCases ..> Domain : aplica regras
DomainServices ..> Entities : valida invariantes
UseCases ..> RepositoryPorts : requer interfaces
RepositoryAdapters ..|> RepositoryPorts : fornece implementações
RepositoryAdapters ..> DatabaseConfig : usa TypeORM

@enduml

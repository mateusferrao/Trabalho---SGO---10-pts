@startuml diagrama-de-componentes

skinparam componentStyle rectangle
skinparam component {
  BackgroundColor LightCyan
  BorderColor SteelBlue
}
skinparam database {
  BackgroundColor LightYellow
  BorderColor DarkGoldenRod
}

package "Camada de Apresentação" {
  [React SPA\n(Vite + TypeScript)] as SPA
}

package "Camada de API\n(Node.js / Express)" {
  [API Gateway\n+ Router] as Gateway

  component "Módulo de Competições" as ModComp {
    [CompetitionController]
    [CompetitionUseCase]
  }

  component "Módulo de Inscrições" as ModInsc {
    [InscricaoController]
    [InscricaoUseCase]
  }

  component "Módulo de Alocação" as ModAloc {
    [AlocacaoController]
    [AlocacaoUseCase]
  }

  component "Módulo de Resultados" as ModResult {
    [ResultadoController]
    [ResultadoUseCase]
  }

  component "Módulo de Relatórios" as ModRel {
    [RelatorioController]
    [MedalhaUseCase]
  }

  [TypeORM\n(Data Access Layer)] as ORM
}

database "PostgreSQL 15\n(sgo_db)" as DB {
  [competicoes]
  [atletas]
  [locais]
  [inscricoes]
  [resultados]
  [paises]
}

() "ISGO REST API" as ISgoRest
() "ICompeticaoService" as ICompSvc
() "IInscricaoService" as IInscSvc
() "IAlocacaoService" as IAlocSvc
() "IResultadoService" as IResultSvc
() "IRelatorioService" as IRelSvc

() "ICompeticaoRepository" as ICompRepo
() "IInscricaoRepository" as IInscRepo
() "ILocalRepository" as ILocalRepo
() "IResultadoRepository" as IResultRepo
() "IPaisRepository" as IPaisRepo
() "ISQLConnection" as ISql

Gateway -left- ISgoRest : fornece
SPA ..> ISgoRest : requer\nHTTP/REST JSON

ModComp -up- ICompSvc : fornece
ModInsc -up- IInscSvc : fornece
ModAloc -up- IAlocSvc : fornece
ModResult -up- IResultSvc : fornece
ModRel -up- IRelSvc : fornece

Gateway ..> ICompSvc : requer
Gateway ..> IInscSvc : requer
Gateway ..> IAlocSvc : requer
Gateway ..> IResultSvc : requer
Gateway ..> IRelSvc : requer

ORM -down- ICompRepo : fornece
ORM -down- IInscRepo : fornece
ORM -down- ILocalRepo : fornece
ORM -down- IResultRepo : fornece
ORM -down- IPaisRepo : fornece

ModComp ..> ICompRepo : requer
ModInsc ..> IInscRepo : requer
ModInsc ..> IPaisRepo : requer
ModAloc ..> ILocalRepo : requer
ModAloc ..> ICompRepo : requer
ModResult ..> IResultRepo : requer
ModRel ..> IResultRepo : requer
ModRel ..> IPaisRepo : requer

DB -left- ISql : fornece
ORM ..> ISql : requer\nSQL / TCP 5432

note right of ISgoRest
  Interface fornecida pelo backend
  e requerida pela aplicação web.
end note

note bottom of ICompRepo
  Interfaces de repositório desacoplam
  regras de negócio da persistência.
end note

@enduml
